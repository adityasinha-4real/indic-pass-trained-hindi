# IndicPass environment variables.
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env        # macOS / Linux
#   Copy-Item .env.example .env # Windows PowerShell

# Hugging Face access token. Only needed for gated or private repositories;
# public datasets download fine without it.
# Create one at https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=

# Optional: override where Hugging Face caches downloads. Useful on the
# training PC when the system drive is small.
# HF_HOME=

# Optional: pin the project root explicitly. Normally auto-detected by
# walking up from the source file, so leave this unset.
# INDICPASS_ROOT=

# Optional: override the log level for every script (DEBUG/INFO/WARNING/ERROR).
# INDICPASS_LOG_LEVEL=INFO
