# IndicPass API environment variables.
# Copy to .env and adjust if needed -- both files are optional; the API runs
# with sane defaults for local use with no configuration at all.
#
#   cp .env.example .env        # macOS / Linux
#   Copy-Item .env.example .env # Windows PowerShell

# Comma-separated origins allowed to call this API (CORS). Defaults to the
# Next.js dev server on localhost if unset.
# INDICPASS_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
