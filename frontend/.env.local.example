# IndicPass frontend environment variables.
# Copy to .env.local (git-ignored) and adjust if the API runs somewhere else.
#
#   cp .env.local.example .env.local        # macOS / Linux
#   Copy-Item .env.local.example .env.local # Windows PowerShell

# Base URL of the IndicPass API (see ../api/main.py). Defaults to
# http://localhost:8000 in code if this is left unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
